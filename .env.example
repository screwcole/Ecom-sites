# Higgsfield image generation — copy this file to ".env" and paste your real values.
# Get these from platform.higgsfield.ai → dashboard → API / Keys (Higgsfield gives a key AND a secret).
HIGGSFIELD_API_KEY=your_key_here
HIGGSFIELD_API_SECRET=your_secret_here

# Optional overrides
HIGGSFIELD_BASE=https://platform.higgsfield.ai
