{%- comment -%} How it works — numbered steps, ideal for patch application {%- endcomment -%}
<section class="section{% if section.settings.invert %} invert{% endif %}" style="background:{{ section.settings.bg_color }}">
  <div class="page-width">
    <div class="section-head text-center reveal">
      {%- if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank %}<p class="lede" style="margin-inline:auto">{{ section.settings.subheading }}</p>{% endif -%}
    </div>

    <div class="grid grid--{{ section.blocks.size | at_most: 4 }} steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" {{ block.shopify_attributes }}>
          <span class="step__num">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p class="text-soft">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="text-center" style="margin-top:40px">
        <a href="{{ section.settings.cta_link }}" class="btn btn--primary btn--lg">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Effortless ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps to better days" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Wear it and forget it. Each patch delivers a slow, steady release for up to 8 hours." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Start your routine" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1B3A2F" },
    { "type": "checkbox", "id": "invert", "label": "Light text (for dark backgrounds)", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Peel" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Remove a single patch from the pack each morning." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Peel", "text": "Remove one patch from the pack each morning." } },
        { "type": "step", "settings": { "title": "Stick", "text": "Apply to clean, dry skin — inner forearm, shoulder, or hip." } },
        { "type": "step", "settings": { "title": "Absorb", "text": "NAD+ releases steadily for up to 8 hours. Peel off before bed." } }
      ]
    }
  ]
}
{% endschema %}
