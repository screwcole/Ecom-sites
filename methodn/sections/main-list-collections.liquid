{%- comment -%} All collections listing {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="collection-header reveal"><h1>{{ page_title | default: 'Shop by collection' }}</h1></div>
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="goal-card reveal">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div><h3>{{ collection.title }}</h3><span>{{ collection.products_count }} products</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
