{%- comment -%} Site footer with link columns, newsletter, social, legal {%- endcomment -%}
<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="header__logo" style="display:inline-block;margin-bottom:14px">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" style="width:{{ settings.logo_width }}px;height:auto">
          {%- else -%}{{ shop.name }}{%- endif -%}
        </a>
        <p>{{ section.settings.tagline }}</p>
        {%- if section.settings.show_social -%}{% render 'social-icons' %}{%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'newsletter' -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <p class="text-soft" style="margin-bottom:14px">{{ block.settings.text }}</p>
            {%- form 'customer', class: 'newsletter__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email">
              <button type="submit" class="btn btn--primary">Join</button>
            {%- endform -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.disclaimer }}</span>
      <div class="pill-row">
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Clinically-inspired NAD+ patches for everyday energy, focus, and longevity." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "These statements have not been evaluated by the FDA. This product is not intended to diagnose, treat, cure, or prevent any disease." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
        { "type": "text", "id": "text", "label": "Text", "default": "Longevity science, product drops, and subscriber-only offers." }
      ]
    }
  ]
}
{% endschema %}
