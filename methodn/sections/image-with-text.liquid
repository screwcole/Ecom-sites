{%- comment -%} Split image + text — for founder story, science deep-dive, ingredients {%- endcomment -%}
<section class="section{% if section.settings.invert %} invert{% endif %}" style="background:{{ section.settings.bg_color }}">
  <div class="page-width">
    <div class="split {% if section.settings.layout == 'image_right' %}split--reverse{% endif %} reveal">
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'rounded' }}
        {%- endif -%}
      </div>
      <div class="split__content">
        {%- if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="flow text-soft">{{ section.settings.text }}</div>
        {%- if section.blocks.size > 0 -%}
          <ul class="product__trust" style="margin-top:24px;border:0;padding:0">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <div style="margin-top:28px">
            <a href="{{ section.settings.cta_link }}" class="btn btn--primary">{{ section.settings.cta_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [
      { "value": "image_left", "label": "Left" },
      { "value": "image_right", "label": "Right" }
    ], "default": "image_left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The science" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why transdermal beats a pill" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Swallowed NAD+ is largely broken down in the gut before it reaches your cells. MethodN's transdermal delivery bypasses digestion, releasing NAD+ steadily through the skin for higher, more consistent absorption.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F6F3EC" },
    { "type": "checkbox", "id": "invert", "label": "Light text (for dark backgrounds)", "default": false }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Checklist point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Bypasses first-pass gut metabolism" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "point", "settings": { "text": "Bypasses first-pass gut metabolism" } },
        { "type": "point", "settings": { "text": "Steady 8-hour release, no spikes" } },
        { "type": "point", "settings": { "text": "No pills, powders, or needles" } }
      ]
    }
  ]
}
{% endschema %}
