{%- comment -%} Featured collection — product card grid {%- endcomment -%}
<section class="section" style="background:{{ section.settings.bg_color }}">
  <div class="page-width">
    <div class="section-head text-center reveal">
      {%- if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank %}<p class="lede" style="margin-inline:auto">{{ section.settings.subheading }}</p>{% endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns }}">
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <div class="product-card reveal">
            <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="product-card__title">Example product</div>
            <div class="product-card__price">$49.00</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="text-center" style="margin-top:44px">
        <a href="{{ section.settings.cta_link | default: coll.url }}" class="btn btn--outline btn--lg">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your formula" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Targeted NAD+ blends for the outcome you're after." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Shop all patches" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F6F3EC" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
