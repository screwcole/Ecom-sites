{%- comment -%} Coming-soon / password page content {%- endcomment -%}
<span class="eyebrow">{{ section.settings.eyebrow }}</span>
<h1>{{ section.settings.heading }}</h1>
<p class="lede" style="margin:0 auto 28px">{{ section.settings.text }}</p>

{%- form 'customer', class: 'newsletter__form' -%}
  <input type="hidden" name="contact[tags]" value="prelaunch">
  <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email">
  <button type="submit" class="btn btn--primary">Notify me</button>
  {%- if form.posted_successfully? -%}
    <p style="margin-top:14px;color:var(--color-primary);width:100%">You're on the list. We'll be in touch.</p>
  {%- endif -%}
{%- endform -%}

<div style="margin-top:40px">
  {%- form 'storefront_password', class: 'newsletter__form' -%}
    <input type="password" name="password" placeholder="Enter store password" aria-label="Store password">
    <button type="submit" class="btn btn--outline">Enter</button>
    {%- if form.errors -%}<p style="color:#c0392b;margin-top:10px;width:100%">{{ form.errors.translated_fields.password }} {{ form.errors.messages.password }}</p>{%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Launching soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "NAD+ patches are coming." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be first to feel it. Join the list for early access and a launch-day discount." }
  ]
}
{% endschema %}
