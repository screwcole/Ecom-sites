{%- comment -%} Hero — benefit-led headline, rating proof, dual CTA, product image {%- endcomment -%}
<section class="hero" style="background:{{ section.settings.bg_color }}">
  <div class="page-width">
    <div class="hero__inner">
      <div class="hero__content reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="hero__rating">
            <span class="stars">{% for i in (1..5) %}{% render 'icon', name: 'star', size: 16 %}{% endfor %}</span>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.subheading != blank -%}
          <p class="lede">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="hero__ctas">
          {%- if section.settings.cta_text != blank -%}
            <a href="{{ section.settings.cta_link }}" class="btn btn--primary btn--lg">{{ section.settings.cta_text }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_text != blank -%}
            <a href="{{ section.settings.cta2_link }}" class="btn btn--outline btn--lg">{{ section.settings.cta2_text }}</a>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="hero__badges">
            {%- for block in section.blocks -%}
              <span class="badge badge--soft" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 16 %} {{ block.settings.text }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hero__media reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}"
               alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
               width="1000" height="1250" fetchpriority="high">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'rounded' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Transdermal NAD+ technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cellular energy that lasts all day." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "MethodN delivers a steady stream of NAD+ through your skin — no pills, no needles, no crash. Just clean, sustained vitality." },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 12,000+ patches worn" },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop NAD+ patches" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#EFEADF" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "leaf", "label": "Leaf" },
          { "value": "shield", "label": "Shield" },
          { "value": "flask", "label": "Flask" },
          { "value": "check", "label": "Check" },
          { "value": "truck", "label": "Truck" }
        ], "default": "shield" },
        { "type": "text", "id": "text", "label": "Text", "default": "Third-party tested" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shield", "text": "Third-party tested" } },
        { "type": "badge", "settings": { "icon": "leaf", "text": "Vegan & non-GMO" } },
        { "type": "badge", "settings": { "icon": "flask", "text": "Made in a GMP facility" } }
      ]
    }
  ]
}
{% endschema %}
