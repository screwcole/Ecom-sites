{%- comment -%} Search results {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="collection-header reveal">
      <h1>Search</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter__form" style="margin-top:20px">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search patches, articles…" aria-label="Search">
        <button type="submit" class="btn btn--primary">Search</button>
      </form>
    </div>

    {%- if search.performed -%}
      <p class="text-soft" style="margin-bottom:24px">{{ search.results_count }} results for "{{ search.terms | escape }}"</p>
      {%- if search.results.size > 0 -%}
        <div class="grid grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="card reveal"><h3 style="font-size:1.1rem">{{ item.title }}</h3></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="text-center text-soft" style="padding:48px 0">No results found. Try another search.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
