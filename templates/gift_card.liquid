{%- comment -%} Gift card display {%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }} gift card</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body style="background:#F6F3EC;font-family:'Inter',sans-serif">
    <main style="min-height:100vh;display:grid;place-items:center;padding:40px;text-align:center">
      <div class="card" style="max-width:440px">
        <h1 style="font-family:'Fraunces',serif">{{ shop.name }}</h1>
        <p>Your gift card</p>
        <div style="font-size:2.4rem;font-weight:700;margin:18px 0">{{ gift_card.balance | money }}</div>
        <div id="QrCode" style="display:flex;justify-content:center;margin:8px 0"></div>
        <p style="font-family:monospace;letter-spacing:2px;margin-top:16px">{{ gift_card.code | format_code }}</p>
        <script src="https://cdn.shopify.com/shopifycloud/shopify/assets/themes_support/qrcode-7a4a942a8d6e1d0d6b59be8c08a90c7f8d8d8c9b6f9.js" defer></script>
        <script>window.addEventListener('DOMContentLoaded',function(){new QRCode(document.getElementById('QrCode'),{text:{{ gift_card.qr_identifier | json }},width:120,height:120});});</script>
        <a class="btn btn--primary" href="{{ shop.url }}" style="margin-top:20px">Shop now</a>
      </div>
    </main>
  </body>
</html>
