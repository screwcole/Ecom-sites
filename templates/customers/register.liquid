<section class="section"><div class="page-width" style="max-width:440px">
  <h1 class="text-center">Create account</h1>
  {%- form 'create_customer', class: 'flow' -%}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="First name" style="padding:.9em 1.1em;border:1.5px solid var(--color-border);border-radius:var(--radius);width:100%">
    <input type="text" name="customer[last_name]" placeholder="Last name" style="padding:.9em 1.1em;border:1.5px solid var(--color-border);border-radius:var(--radius);width:100%">
    <input type="email" name="customer[email]" placeholder="Email" required style="padding:.9em 1.1em;border:1.5px solid var(--color-border);border-radius:var(--radius);width:100%">
    <input type="password" name="customer[password]" placeholder="Password" required style="padding:.9em 1.1em;border:1.5px solid var(--color-border);border-radius:var(--radius);width:100%">
    <button type="submit" class="btn btn--primary btn--block btn--lg">Create account</button>
    <p class="text-center text-soft">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
  {%- endform -%}
</div></section>
