<section class="section"><div class="page-width" style="max-width:440px">
  <h1 class="text-center">Set a new password</h1>
  {%- form 'reset_customer_password', class: 'flow' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="New password" required style="padding:.9em 1.1em;border:1.5px solid var(--color-border);border-radius:var(--radius);width:100%">
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required style="padding:.9em 1.1em;border:1.5px solid var(--color-border);border-radius:var(--radius);width:100%">
    <button type="submit" class="btn btn--primary btn--block btn--lg">Reset password</button>
  {%- endform -%}
</div></section>
