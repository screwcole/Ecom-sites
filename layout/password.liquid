<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>
    {% if settings.favicon != blank %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">{% else %}<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">{% endif %}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% style %}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-text-soft: {{ settings.color_text }}b3;
        --color-primary: {{ settings.color_primary }};
        --color-primary-text: {{ settings.color_primary_text }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-border: {{ settings.color_text }}1f;
        --radius: {{ settings.corner_radius }}px;
        --radius-lg: {{ settings.corner_radius | times: 2 }}px;
        --page-width: {{ settings.page_width }}px;
        --font-heading: 'Fraunces', Georgia, serif;
        --font-body: 'Inter', sans-serif;
      }
    {% endstyle %}
    {{ content_for_header }}
  </head>
  <body>
    <main style="min-height:100vh;display:grid;place-items:center;text-align:center;padding:40px">
      <div style="max-width:480px">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" style="width:{{ settings.logo_width }}px;height:auto;margin:0 auto 24px">
        {% else %}
          <div class="header__logo" style="font-size:2.4rem;margin-bottom:16px">{{ shop.name }}</div>
        {% endif %}
        {{ content_for_layout }}
      </div>
    </main>
  </body>
</html>
