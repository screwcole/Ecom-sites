[
  {
    "name": "theme_info",
    "theme_name": "MethodN",
    "theme_version": "1.0.0",
    "theme_author": "Sainto Group",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand colors",
    "settings": [
      {
        "type": "header",
        "content": "Foundation"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#F6F3EC"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card / surface",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#18181B"
      },
      {
        "type": "header",
        "content": "Primary (buttons, headings accents)"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary",
        "default": "#1B3A2F"
      },
      {
        "type": "color",
        "id": "color_primary_text",
        "label": "Primary text",
        "default": "#F6F3EC"
      },
      {
        "type": "header",
        "content": "Accent (highlights, savings, energy)"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#D6FF6B"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Accent text",
        "default": "#18181B"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1280
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Slide-out drawer" },
          { "value": "page", "label": "Cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "cart_free_shipping_threshold",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "$",
        "label": "Free shipping threshold",
        "default": 75
      }
    ]
  },
  {
    "name": "Brand identity",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_x", "label": "X (Twitter) URL" }
    ]
  }
]
